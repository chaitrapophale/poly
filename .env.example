# POLY Master Environment Variables
# AGORA REAL-TIME VOICE CREDENTIALS (Required for live voice streams)
AGORA_APP_ID=your_agora_app_id_here
AGORA_APP_CERTIFICATE=your_agora_app_certificate_here

# GOOGLE GEMINI LLM API KEY
GEMINI_API_KEY=your_gemini_api_key_here

# BACKEND CONFIG
PORT=8000
DATABASE_URL=sqlite:///./poly.db
SECRET_KEY=poly-agora-secret-key-change-in-production
