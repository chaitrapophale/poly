# POLY Server Config
PORT=8000
HOST=0.0.0.0
ENV=development
SECRET_KEY=poly-agora-secret-key-change-in-production

# PostgreSQL Database (Fallback to SQLite if empty)
DATABASE_URL=sqlite:///./poly.db

# Agora Real-Time Voice Credentials (Get from https://console.agora.io)
AGORA_APP_ID=your_agora_app_id
AGORA_APP_CERTIFICATE=your_agora_app_certificate

# Google Gemini API Config
GEMINI_API_KEY=your_gemini_api_key
